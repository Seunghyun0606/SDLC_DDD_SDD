{
  "schema_version": 1,
  "provider_id": "EXTERNAL_AGENT_PROVIDER_REQUIRED",
  "provider_class": "EXTERNAL_AGENT",
  "enabled": false,
  "run_count": 3,
  "timeout_seconds": 120,
  "result_filename": "stage-result.json",
  "command": [],
  "supported_work_placeholders": [
    "{context_path}",
    "{result_path}",
    "{artifact_path}",
    "{artifact_rel}",
    "{target_id}",
    "{stage}",
    "{root}",
    "{run_dir}"
  ],
  "rules": {
    "same_input_required": true,
    "actual_provider_execution_required_for_pass": true,
    "semantic_fingerprint_compared": true,
    "volatile_timestamp_difference_ignored": true,
    "llm_determinism_claimed": false,
    "validation_fixture_provider_is_not_agent_empirical_pass": true,
    "provider_class_is_declaration_only": true,
    "provider_class_label_is_empirical_agent_proof": false,
    "actual_low_level_agent_requires_separate_observed_pilot": true
  },
  "note": "Project가 실제 Agent/LLM CLI 또는 wrapper를 연결한 뒤 enabled=true와 command를 설정한다. 반복성 Runner는 Provider command와 의미 일치율만 관측하며 provider_class=EXTERNAL_AGENT 라벨만으로 실제 Agent 실증 PASS를 만들지 않는다. 실제 저수준 Agent와 Human first-use는 별도 관찰 Pilot Evidence로 기록한다."
}
