{
  "schema_version": 1,
  "candidate_design": "v1.10.1-projection-hygiene",
  "purpose": "Canonical/Runtime 내부 의미와 사람용 Projection 표현을 분리하여 개발자와 고객에게 각자의 작업에 필요한 정보만 노출한다.",
  "scope": "HUMAN_PROJECTION_VISIBILITY",
  "principles": {
    "projection_is_not_ssot": true,
    "selector_metadata_may_use_canonical_ids": true,
    "human_body_uses_audience_language": true,
    "allowlist_before_sanitize": true,
    "sanitizer_is_defense_in_depth": true,
    "stable_block_ids_may_exist_as_hidden_markers": true,
    "runtime_states_are_translated_for_humans": true,
    "machine_traceability_is_preserved_when_hidden_from_human_body": true
  },
  "machine_only_default": [
    "canonical_entity_type",
    "canonical_entity_id",
    "canonical_revision",
    "relation_type",
    "provenance",
    "evidence_class",
    "confidence",
    "stage_taxonomy",
    "change_level",
    "runtime_guard_code",
    "queue_id",
    "block_id",
    "hash",
    "locator",
    "projection_lifecycle_state"
  ],
  "engineering_visible": [
    "functional_intent",
    "business_rule",
    "scenario",
    "scope",
    "program",
    "source_file",
    "source_symbol",
    "method",
    "query",
    "table",
    "column",
    "interface",
    "batch",
    "procedure",
    "authorization",
    "input_output",
    "transaction",
    "implementation_order",
    "test_method",
    "open_human_decision",
    "as_built"
  ],
  "customer_visible": [
    "request_background",
    "expected_result",
    "current_process",
    "target_process",
    "business_rule",
    "scope",
    "out_of_scope",
    "business_impact",
    "decision_needed",
    "agreement",
    "acceptance",
    "test_result",
    "operations_handover",
    "open_customer_question"
  ],
  "human_translation_examples": {
    "SOURCE_BLOCK": "개발 전 확인 필요",
    "ITERATE": "진행 가능·추후 보완",
    "ALERT": "주의사항",
    "BEFORE_SOURCE_WRITE": "개발 시작 전",
    "BEFORE_TEST": "테스트 전",
    "BEFORE_VERIFY": "최종 검증 전",
    "CONFIRMED_BUSINESS": "확정",
    "DEFERRED": "보류"
  },
  "block_marker_policy": {
    "format": "HTML_COMMENT",
    "example": "<!-- BLOCK_ID: WU-BUSINESS-RULE -->",
    "visible_block_catalog_in_human_body": false,
    "purpose": "Agent가 자연어로 지시된 문서 영역을 안정적으로 식별하되 내부 Block ID를 일반 사용자에게 강요하지 않는다."
  },
  "customer_direct_canonical_policy": {
    "default": "ALLOWLIST_ONLY",
    "relation_expansion": "DENY_BY_DEFAULT",
    "technical_detail": "EXPLICIT_OPTIONAL_APPENDIX_ONLY",
    "evidence_detail": "EXPLICIT_OPTIONAL_APPENDIX_ONLY",
    "sanitizer_role": "SECONDARY_DEFENSE"
  },
  "engineering_policy": {
    "technical_detail": "SHOW_WHEN_NEEDED_FOR_IMPLEMENTATION",
    "framework_taxonomy": "HIDE_OR_TRANSLATE",
    "source_trace": "SHOW_IMPLEMENTATION_RELEVANT_LOCATORS_ONLY",
    "machine_guard_codes": "TRANSLATE_TO_HUMAN_IMPACT"
  }
}
