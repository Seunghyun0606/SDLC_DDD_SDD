    "sdlc/scripts/change_execution_runtime.py",
    "sdlc/scripts/delivery_status_runtime.py",
    "sdlc/scripts/component_state_runtime.py",
    "sdlc/scripts/impact_learning_runtime.py",
    "sdlc/scripts/unexpected_discovery_runtime.py",
    "sdlc/scripts/projection_lifecycle_runtime.py",
    "sdlc/scripts/customer_projection_runtime.py",
    "sdlc/scripts/render_customer_document.py",
    "sdlc/design/contracts/customer-document-contract.json",
    "sdlc/config/customer-document-profile.example.json",
    "sdlc/scripts/architecture_check.py",
    "sdlc/config/architecture-rules.json",
    "sdlc/scripts/sdlc_metrics_runtime.py",
    "sdlc/design/contracts/project-scaffold-contract.json",
    "sdlc/scripts/build_project_scaffold.py"
  ],
  "exclude_exact": ["sdlc/tailoring/standard/STAGE_ORIENTED_FULL.yaml"],
  "exclude_prefixes": [
