{
  "schema_version": 1,
  "contract_id": "PROJECT_SCAFFOLD_V19_REDTEAM",
  "source_package_contract": "sdlc/design/contracts/harness-package-contract.json",
  "purpose": "Framework 개발/검증 이력을 실제 프로젝트 배포 Scaffold에서 제외하고 Runtime/Template/Config/Guide만 배포한다.",
  "base_file_set": "core_required_files",
  "add_required_files": [
