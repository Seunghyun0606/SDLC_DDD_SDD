{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Business Rule Candidate",
  "type": "object",
  "required": ["br_candidate_id","normalized_statement","source_evidence","review_status"],
  "properties": {
    "br_candidate_id":{"type":"string"},
    "title":{"type":"string"},
    "original_text":{"type":"string"},
    "normalized_statement":{"type":"string"},
    "condition":{"type":"array","items":{"type":"string"}},
    "actor":{"type":"array","items":{"type":"string"}},
    "action_or_decision":{"type":"array","items":{"type":"string"}},
    "outcome":{"type":"array","items":{"type":"string"}},
    "exception":{"type":"array","items":{"type":"string"}},
    "effective_period":{"type":"object"},
    "source_evidence":{"type":"array","minItems":1,"items":{"type":"object","required":["document_id","locator","source_hash","confidence"],"properties":{"document_id":{"type":"string"},"locator":{"type":"string"},"source_hash":{"type":"string"},"confidence":{"type":"string"},"authority":{"type":"string"},"status":{"type":"string"}}}},
    "related_ids":{"type":"array","items":{"type":"string"}},
    "conflict_group":{"type":["string","null"]},
    "review_status":{"enum":["CANDIDATE","REVIEW_REQUIRED","CONFIRMED","CONFLICT","SUPERSEDED","REJECTED"]}
  }
}
