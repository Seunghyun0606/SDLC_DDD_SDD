{
  "schema_version": 2,
  "contract_id": "ARTIFACT_TAILORING_V1",
  "candidate_design": "v1.9.0-tailoring-control-plane",
  "purpose": "Harness 내부 Stage/Canonical/Evidence와 사람이 사용하는 Artifact의 문서 체계를 분리한다.",
  "principles": {
    "stage_is_internal_execution_semantics": true,
    "template_defines_expression_shape": true,
    "tailoring_defines_projection_mapping": true,
    "core_stage_contracts_must_not_be_duplicated_per_customer": true,
    "custom_template_only_is_not_sufficient": true,
    "canonical_semantic_identity_is_change_level_invariant": true,
    "change_level_controls_work_and_projection_density_not_business_truth_schema": true,
    "projection_omission_does_not_mean_canonical_semantic_deletion": true
  },
  "audiences": ["MACHINE", "INTERNAL_IT", "PM_REVIEW", "CUSTOMER"],
  "mapping_cardinality": ["N_STAGE_TO_1_ARTIFACT", "1_STAGE_TO_N_ARTIFACT", "N_STAGE_TO_N_ARTIFACT"],
  "artifact_fields": {
    "required": ["id", "audience", "template", "sources", "visibility", "authoring"],
    "optional": ["condition", "change_levels", "output_path", "sections", "freshness_policy"]
  },
  "source_selectors": {
    "stages": "One or more internal Stage names",
    "canonical": "Canonical entity/field selectors",
    "evidence": "Machine evidence selectors",
    "artifact": "Previously generated Internal IT artifact references"
  },
  "visibility": ["PRIMARY", "SECONDARY", "HIDDEN_MACHINE"],
  "authoring": [
    "AGENT_DRAFT_HUMAN_REVIEW",
    "HUMAN_AUTHORITATIVE",
    "GENERATED_VIEW",
    "MACHINE_ONLY"
  ],
  "conditions": [
    "ALWAYS",
    "HAS_UI",
    "HAS_INTERFACE",
    "HAS_BATCH",
    "HAS_DATA_CHANGE",
    "HAS_SECURITY_IMPACT",
    "CHANGE_LEVEL_AT_LEAST"
  ],
  "canonical_projection_invariant": {
    "canonical_authority": "Canonical Business/Design Truth and accepted decisions remain authoritative regardless of L1-L5.",
    "change_level_effect": "L1-L5 selects required Semantic Work, Evidence, Review depth and which Human Artifacts need to be materialized; it never deletes or rewrites Canonical semantics merely because the level is lower.",
    "internal_it_layer": {
      "default_profile": "STANDARD_5",
      "role": "DESIGN_DEVELOPMENT_HUMAN_REVIEW_SURFACE",
      "default_authoring": "AGENT_DRAFT_HUMAN_REVIEW",
      "may_hide_or_collapse_irrelevant_sections": true,
      "omitted_section_means": "VIEW_NOT_MATERIALIZED_OR_NOT_APPLICABLE; not Canonical deletion"
    },
    "customer_layer": {
      "default_profile": "CUSTOMER_STANDARD_3",
      "role": "GENERATED_COMMUNICATION_VIEW",
      "default_authoring": "GENERATED_VIEW",
      "may_rephrase_or_hide_internal_ids_and_machine_detail": true,
      "business_truth_authority": false,
      "customer_edit_auto_updates_canonical": false
    },
    "required_trace": ["target_id", "canonical_revision"],
    "recommended_validation": "target-scoped canonical semantic fingerprint must remain identical across L1-L5 projection resolution"
  },
  "runtime_requirements": {
    "profile_selected_from_project_config": true,
    "profile_id_only_in_project_yaml": true,
    "template_path_not_required_from_normal_user": true,
    "stage_selection_not_required_from_normal_user": true,
    "projection_must_not_create_new_business_truth": true,
    "machine_evidence_default_hidden_from_primary_artifacts": true,
    "change_level_must_not_mutate_canonical_during_projection_resolution": true,
    "customer_projection_must_remain_independent_of_internal_document_count": true
  },
  "profile_resolution_order": [
    "sdlc/custom/project/tailoring",
    "sdlc/tailoring/standard",
    "explicit_extension_registry"
  ],
  "validation": {
    "unknown_stage_fails": true,
    "unknown_audience_fails": true,
    "missing_template_fails": true,
    "duplicate_artifact_id_fails": true,
    "customer_projection_without_canonical_or_internal_source_fails": true,
    "stage_removal_by_tailoring_forbidden": true,
    "canonical_identity_change_caused_only_by_level_resolution_fails": true,
    "customer_generated_view_claiming_business_truth_fails": true
  }
}
