{
  "schema_version": 4,
  "candidate_design": "v1.7-session-first-integration-v0.1",
  "user_onboarding": {
    "entrypoint": "docs/00_시작/START_HERE.md",
    "project_setup_guide": "docs/00_시작/프로젝트_설정_가이드.md",
    "project_config": ".sdlc/project.yaml",
    "internal_framework_structure_required_for_user": false,
    "primary_setup_inputs": ["project_name", "project_mode", "delivery_profile"],
    "unknown_mode_defaults_to": "AUTO",
    "general_delivery_defaults_to": "STANDARD",
    "agent_draft_first": true,
    "human_reviews_decisions_not_blank_templates": true,
    "unknown_information_remains_open": true,
    "zero_to_one_requirement_intake": "CONNECTED",
    "requirement_intake_entrypoint": "python sdlc/scripts/harness.py intake <requirement-file.xlsx>",
    "intake_returns_concrete_rq_target": true
  },
  "modes": {
    "GREENFIELD": {
      "starter_path": "sdlc/starter-kits/greenfield",
      "startable_minimum": ["project.objective", "requirement_sources"],
      "source_required_to_start": false,
      "readiness_states": ["STARTABLE", "DESIGN_READY", "IMPLEMENTATION_READY"]
    },
    "BROWNFIELD": {
      "starter_path": "sdlc/starter-kits/brownfield",
      "startable_minimum": ["analysis_seed.text", "repository.reference"],
      "source_required_to_confirm_source_analysis": true,
      "impact_required_relation_types": [
        "ENTRY_POINT",
        "CALLER",
        "CALLEE",
        "DATA_READ_WRITE",
        "TRANSACTION",
        "EXTERNAL_INTERFACE",
        "EVENT",
        "CONFIG_FEATURE_FLAG",
        "TEST",
        "MODULE_BUILD_DEPENDENCY"
      ],
      "impact_required_result_classes": ["DIRECT_IMPACT", "INDIRECT_IMPACT", "CHECK_REQUIRED", "OUT_OF_SCOPE"],
      "coverage_gaps_must_be_reported": true,
      "project_specific_impact_adapter_required": true,
      "missing_project_adapter_status": "PARTIAL_PROJECT_ADAPTER_REQUIRED",
      "readiness_states": ["STARTABLE", "IMPACT_ANALYSIS_READY", "IMPLEMENTATION_READY"]
    }
  },
  "shared_invariants": {
    "missing_recommended_input_is_non_blocking": true,
    "customer_originals_are_preserved": true,
    "secrets_must_not_be_in_starter_kit": true,
    "business_truth_is_not_inferred_from_source_automatically": true,
    "implementation_ready_requires_program_dor": true,
    "canonical_ids_remain_stable": true,
    "onboarding_entrypoint_must_exist": true,
    "setup_must_route_user_to_entrypoint": true,
    "setup_must_not_fake_missing_requirement_target": true,
    "similar_requirement_groups_must_not_auto_merge": true
  },
  "reverse_engineering": {
    "status": "PARTIAL_CORE_ENABLED",
    "core_enabled_scopes": ["DRIFT_CHECK"],
    "enhancement_scopes": ["INVENTORY", "REVERSE_SPEC", "SEMANTIC_SOURCE_DIFF", "AUTOMATIC_ARTIFACT_REWRITE"],
    "drift_contract": "sdlc/design/contracts/source-drift-contract.json",
    "automatic_artifact_rewrite": false,
    "automatic_business_truth_promotion": false
  }
}
