    "IMPACT": {"reference":"impact.md","template":"impact-analysis.md","source_evidence":true},
    "DESIGN": {"reference":"design.md","template":"functional-design.md","source_evidence":true},
    "PROGRAM": {"reference":"program.md","template":"program-spec.md","source_evidence":true,"readiness_contract":true},
    "DEVELOPMENT": {"reference":"development.md","template":"implementation-result.md","source_evidence":true},
    "TEST": {"reference":"test.md","template":"test-scenario.md","source_evidence":true},
    "VERIFY": {"reference":"verify.md","template":"verification-result.md","source_evidence":true}
