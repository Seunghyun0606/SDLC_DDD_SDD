{
  "schema_version": 2,
  "contract_id": "PROJECT_RQ_WORKLIST_V110",
  "purpose": "PM/이해관계자가 RQ 배정·계획과 Evidence 기반 진행상태를 한 화면에서 관리하되 Canonical Business Truth와 PM 계획을 분리한다.",
  "authority": {
    "business_truth": "sdlc/canonical/store.json",
    "pm_planning": ".sdlc/management/rq-planning.json",
    "runtime_status": "tailored_check + delivery + projection lifecycle"
  },
  "sources": {
    "business_truth": "sdlc/canonical/store.json",
    "pm_planning": ".sdlc/management/rq-planning.json",
    "runtime_status": "tailored_check + delivery + projection lifecycle"
  },
  "editable_file": {
    "formats": ["XLSX", "CSV"],
    "required_identity_column": "RQ",
    "read_only_context_columns": ["요구사항명", "외부 요구ID"],
    "planning_column_policy": "ANY_USER_DEFINED_NON_SYSTEM_COLUMN",
    "default_import_column_mode": "REPLACE",
    "merge_column_mode_available": true,
    "column_add_remove_is_pm_schema_change": true,
    "custom_columns_affect_canonical": false
  },
  "planning_fields": [
    "priority", "pm_owner", "business_owner", "engineering_owner", "test_owner",
    "customer_decision_owner", "milestone", "planned_start", "planned_end", "note"
  ],
  "planning_fields_policy": "LEGACY_CONVENIENCE_ONLY_NOT_CLOSED_SCHEMA",
  "system_derived_columns": [
    "working_state", "change_level", "human_decision_count", "evidence_passed", "projection_state", "next_action"
  ],
  "derived_columns": [
    "rq_id", "title", "external_requirement_ids", "working_state", "change_level",
    "human_decision_count", "evidence_passed", "projection_state", "next_action"
  ],
  "rules": {
    "pm_planning_never_mutates_business_truth": true,
    "pm_may_define_project_specific_columns": true,
    "runtime_status_is_not_pm_editable": true,
    "derived_column_name_collision_is_rendered_with_pm_prefix": true,
    "incremental_intake_preserves_existing_planning_by_rq_id": true,
    "new_rq_appears_without_manual_row_creation": true,
    "status_is_evidence_based_not_manual_percent_complete": true,
    "requirement_semantic_change_uses_change_workflow": true,
    "bulk_import_validates_all_rq_before_write": true
  },
  "human_view": "docs/00_관리/RQ_작업목록.md",
  "editable_default": "docs/00_관리/RQ_작업관리.xlsx",
  "runtime_view": "sdlc/runtime/management/rq-worklist.json"
}
