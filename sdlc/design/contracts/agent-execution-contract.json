{
  "schema_version": 4,
  "candidate_design": "v1.7-wp4-work-handoff-v0.1",
  "purpose": "저수준 Agent가 Evidence 기반 산출물을 작성하고 Machine 결과를 검증 가능하게 남기되, 일반 사용자는 내부 Rule/Skill/Reference/Contract를 학습하지 않고 사람 판단권한 항목만 확인하도록 하는 Core 실행계약",
  "scope": "CORE_COMMON_CONTRACT",
  "required_reference_sections": [
    "## Purpose",
    "## Required Input",
    "## Optional Input",
    "## Retrieval Strategy",
    "## 실행 계약(Agent Execution Contract)",
    "## Steps",
    "## Output",
    "## Quality Check",
    "## Alert Conditions",
    "## Token Strategy",
    "## Do Not"
  ],
  "execution_contract_required_markers": [
    "입력 필드",
    "근거 분류",
    "실행 순서",
    "계속/중단 조건",
    "출력 필드 매핑",
    "품질 게이트",
    "미확정/실패 처리"
  ],
  "evidence_classes": ["GIVEN", "OBSERVED", "INFERRED", "ASSUMED", "CONFIRMED"],
  "uncertainty_states": ["OPEN", "CHECK_REQUIRED", "CONFLICT", "STALE"],
  "common_rules": {
    "missing_optional_input_is_non_blocking": true,
    "missing_required_business_truth_does_not_allow_invention": true,
    "source_observation_is_not_automatic_business_truth": true,
    "output_must_map_to_canonical_or_explicit_candidate": true,
    "quality_gate_failure_is_reported_not_hidden": true,
    "dangerous_source_write_uses_execution_guard": true,
    "stage_result_must_be_machine_verifiable": true,
    "artifact_and_canonical_delta_must_reference_same_stage_output": true,
    "target_stage_and_artifact_can_be_selected_independently": true,
    "explicit_stage_selection_does_not_authorize_business_truth_change": true,
    "existing_entity_mutation_is_scoped_to_selected_target_graph": true,
    "evidence_researchable_unknown_stays_agent_owned_open": true,
    "human_review_requires_explicit_authority_metadata": true,
    "human_review_does_not_auto_mutate_business_fields": true
  },
  "runtime_output_envelope": {
    "schema_version": 1,
    "validator": "sdlc/scripts/validate_agent_stage_result.py",
    "required_fields": ["stage", "artifact_path", "canonical_delta", "quality_gate", "alerts", "uncertainty"],
    "quality_gate_status": ["PASS", "WARNING", "FAIL"],
    "canonical_delta_required": true,
    "canonical_no_change_supported": true,
    "canonical_no_change_requires_reason": true,
    "artifact_must_exist": true,
    "unresolved_template_placeholder_allowed": false,
    "artifact_path_must_be_repository_relative": true,
    "delta_stage_must_match_result_stage": true,
    "delta_source_artifact_must_match_artifact_path": true,
    "quality_fail_is_not_executable": true,
    "optional_human_decision_metadata": {
      "requires_human_decision": true,
      "category": ["BUSINESS_POLICY", "SCOPE", "APPROVAL", "TECHNICAL_CHOICE", "ACCEPTANCE"],
      "question": "사람이 실제로 결정해야 하는 한 가지 질문",
      "rule": "requires_human_decision=true 이고 허용 category인 uncertainty만 일반 사용자 review 항목으로 노출한다. 단순 Evidence 부족이나 Agent가 추가 조사 가능한 OPEN은 사람에게 떠넘기지 않는다."
    }
  },
  "work_executor": {
    "user_entrypoint": "sdlc/scripts/harness.py work",
    "user_handoff_adapter": "sdlc/scripts/work_handoff.py",
    "guarded_executor": "sdlc/scripts/run_work.py",
    "human_review_adapter": "sdlc/scripts/review_work.py",
    "decision_recorder": "sdlc/scripts/capture_customer_decision.py",
    "default_human_document_root": "docs/10_산출물",
    "machine_runtime_root": "sdlc/runtime",
    "target_id_open_ended": true,
    "explicit_stage_reentry": true,
    "explicit_artifact_override": true,
    "canonical_target_optional_when_stage_or_artifact_is_explicit": true,
    "stage_selection_order": ["USER_STAGE_OVERRIDE", "EXPLICIT_ARTIFACT_STAGE", "TARGET_PROVENANCE_NEXT_STAGE", "TARGET_TYPE_DEFAULT"],
    "target_graph_scope_guard": true,
    "confirmed_business_change_requires_explicit_authorization": true,
    "provider_command_required_for_generation": true,
    "provider_disabled_result": "NOT_EXECUTED_PROVIDER_UNAVAILABLE_OR_DISABLED",
    "user_document_and_machine_result_are_separate": true,
    "human_review_is_new_stage": false,
    "review_json_user_authored": false
  },
  "repeatability": {
    "semantic_fingerprint_supported": true,
    "volatile_fields_ignored": ["generated_at", "updated_at", "created_at", "checked_at", "observed_at"],
    "same_input_clean_run_expectation": "SEMANTIC_MATCH",
    "semantic_mismatch_must_be_reported": true,
    "validator_does_not_claim_llm_determinism": true,
    "full_work_runner": "sdlc/scripts/run_work_repeatability_experiment.py",
    "validation_fixture_provider_may_test_wiring": true,
    "validation_fixture_provider_may_claim_agent_empirical_pass": false,
    "actual_agent_provider_class": "EXTERNAL_AGENT"
  },
  "format_guidance": {
    "reference_document_is_executable_instruction": true,
    "template_is_agent_output_format_not_user_form": true,
    "project_specific_retrieval_logic_belongs_to_profile_or_adapter": true,
    "stage_result_envelope_is_machine_output_not_user_document": true,
    "normal_user_must_not_edit_rule_skill_reference_contract": true,
    "normal_user_must_not_start_from_blank_stage_template": true
  }
}
