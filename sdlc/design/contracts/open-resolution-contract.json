{
  "schema_version": 2,
  "candidate_design": "v1.6.0-rc.1",
  "purpose": "OPEN을 실제 해소 가능한 Backlog로 유지하되 사람이 직접 관리하는 분류와 상태는 최소화하고 세부 Machine taxonomy는 내부 metadata로 분리한다.",
  "scope": "CORE_COMMON_CONTRACT_WITH_PROJECT_AUTHORITY_PROFILE",
  "principles": {
    "open_is_actionable_design_backlog": true,
    "sop_is_optional": true,
    "missing_sop_does_not_block_design": true,
    "proposal_is_not_automatic_business_truth": true,
    "existing_system_observation_is_not_automatic_target_policy": true,
    "technical_decisions_may_be_accepted_without_customer_confirmation_when_project_authority_allows": true,
    "business_truth_requires_business_authority": true,
    "human_view_is_simpler_than_machine_metadata": true,
    "machine_taxonomy_should_not_be_manually_entered_when_derivable": true
  },
  "human_view": {
    "required_fields": [
      "open_item_id",
      "related_id",
      "question_or_gap",
      "resolution_action",
      "current_or_proposed_value",
      "decision_owner_role",
      "human_status"
    ],
    "status_values": ["미확정", "확인중", "제안", "확정", "보류"],
    "labels": {
      "question_or_gap": "무엇을 확인하거나 결정해야 하는가",
      "resolution_action": "어떻게 확인할 것인가",
      "current_or_proposed_value": "현재 확인된 내용 또는 제안",
      "decision_owner_role": "누가 확인하거나 결정하는가",
      "human_status": "진행 상태"
    }
  },
  "categories": [
    "SIX_W_WHO", "SIX_W_WHEN", "SIX_W_WHERE", "SIX_W_WHAT", "SIX_W_HOW", "SIX_W_WHY",
    "BUSINESS_RULE", "UI_SCREEN", "FIELD", "CRUD", "DATA_QUERY", "COMMON_CODE", "INTEGRATION", "AUTHORIZATION", "EXCEPTION", "AC_TC", "NFR"
  ],
  "decision_domains": ["BUSINESS", "FUNCTIONAL", "UX", "TECHNICAL", "DATA", "INTEGRATION", "QUALITY"],
  "resolution_methods": [
    "CUSTOMER_INTERVIEW", "BUSINESS_OWNER_INTERVIEW", "WORKSHOP",
    "EXISTING_SYSTEM_ANALYSIS", "SOURCE_ANALYSIS", "DATA_ANALYSIS",
    "PROJECT_STANDARD", "REFERENCE_PATTERN", "REGULATION_REFERENCE",
    "DESIGNER_PROPOSAL", "DEVELOPER_PROPOSAL", "ARCHITECT_DECISION", "QA_ANALYSIS", "DEFER"
  ],
  "basis_classes": [
    "CONFIRMED_BUSINESS_INPUT", "OBSERVED_AS_IS", "PROJECT_STANDARD", "REGULATION_OR_POLICY_REFERENCE",
    "DESIGN_PROPOSAL", "TECHNICAL_PROPOSAL", "TEST_PROPOSAL", "ASSUMPTION"
  ],
  "resolution_status": [
    "OPEN", "ANALYZING", "CANDIDATE", "PROPOSED", "OBSERVED_AS_IS", "ACCEPTED_DESIGN", "CONFIRMED_BUSINESS", "CONFLICT", "DEFERRED", "N_A"
  ],
  "human_status_mapping": {
    "OPEN": "미확정",
    "ANALYZING": "확인중",
    "CANDIDATE": "확인중",
    "PROPOSED": "제안",
    "OBSERVED_AS_IS": "확인중",
    "ACCEPTED_DESIGN": "확정",
    "CONFIRMED_BUSINESS": "확정",
    "CONFLICT": "보류",
    "DEFERRED": "보류",
    "N_A": "확정"
  },
  "machine_required_item_fields": [
    "open_item_id", "related_id", "category", "decision_domain", "question_or_gap", "resolution_method",
    "basis_class", "proposed_or_observed_value", "evidence_or_rationale", "decision_owner_role", "resolution_status", "downstream_impact"
  ],
  "resolution_rules": {
    "business_domain": "설계/개발 제안은 제안 상태까지만 가능하며 업무 확정은 Business Authority 확인이 필요하다.",
    "technical_domain": "프로젝트 표준, Source 분석, Architect 결정 등 프로젝트 권한 Profile이 허용한 근거가 있으면 설계 확정으로 해소할 수 있다.",
    "ux_domain": "디자이너가 제안할 수 있으나 고객/PO/UX Owner 확인 필요 여부는 Project Profile의 authority_matrix를 따른다.",
    "brownfield": "현행 시스템/Source 분석 결과는 AS-IS 관찰이며 TO-BE 업무정책으로 자동 승격하지 않는다.",
    "greenfield": "Source가 없어도 설계자/개발자 제안과 프로젝트 표준으로 Target 후보를 구체화할 수 있다.",
    "non_blocking": "OPEN이 남아도 가능한 설계는 계속하되 실제 구현 Guard에는 미해소 항목을 반영한다."
  },
  "default_resolution_route": {
    "SIX_W_WHO": ["CUSTOMER_INTERVIEW", "EXISTING_SYSTEM_ANALYSIS", "DESIGNER_PROPOSAL"],
    "SIX_W_WHEN": ["BUSINESS_OWNER_INTERVIEW", "EXISTING_SYSTEM_ANALYSIS", "SOURCE_ANALYSIS", "DESIGNER_PROPOSAL"],
    "SIX_W_WHERE": ["EXISTING_SYSTEM_ANALYSIS", "SOURCE_ANALYSIS", "DESIGNER_PROPOSAL"],
    "SIX_W_WHAT": ["CUSTOMER_INTERVIEW", "EXISTING_SYSTEM_ANALYSIS", "DATA_ANALYSIS"],
    "SIX_W_HOW": ["WORKSHOP", "EXISTING_SYSTEM_ANALYSIS", "DESIGNER_PROPOSAL", "DEVELOPER_PROPOSAL"],
    "SIX_W_WHY": ["BUSINESS_OWNER_INTERVIEW", "REGULATION_REFERENCE"],
    "BUSINESS_RULE": ["BUSINESS_OWNER_INTERVIEW", "WORKSHOP", "EXISTING_SYSTEM_ANALYSIS"],
    "UI_SCREEN": ["EXISTING_SYSTEM_ANALYSIS", "DESIGNER_PROPOSAL", "PROJECT_STANDARD"],
    "FIELD": ["EXISTING_SYSTEM_ANALYSIS", "SOURCE_ANALYSIS", "DATA_ANALYSIS", "DESIGNER_PROPOSAL"],
    "CRUD": ["SOURCE_ANALYSIS", "EXISTING_SYSTEM_ANALYSIS", "DEVELOPER_PROPOSAL"],
    "DATA_QUERY": ["SOURCE_ANALYSIS", "DATA_ANALYSIS", "DEVELOPER_PROPOSAL", "PROJECT_STANDARD"],
    "COMMON_CODE": ["SOURCE_ANALYSIS", "DATA_ANALYSIS", "PROJECT_STANDARD"],
    "INTEGRATION": ["SOURCE_ANALYSIS", "EXISTING_SYSTEM_ANALYSIS", "ARCHITECT_DECISION"],
    "AUTHORIZATION": ["BUSINESS_OWNER_INTERVIEW", "EXISTING_SYSTEM_ANALYSIS", "SOURCE_ANALYSIS"],
    "EXCEPTION": ["WORKSHOP", "EXISTING_SYSTEM_ANALYSIS", "DEVELOPER_PROPOSAL", "QA_ANALYSIS"],
    "AC_TC": ["CUSTOMER_INTERVIEW", "QA_ANALYSIS", "DEVELOPER_PROPOSAL"],
    "NFR": ["PROJECT_STANDARD", "ARCHITECT_DECISION", "CUSTOMER_INTERVIEW"]
  }
