{
  "schema_version": 3,
  "customer": "CUSTOM_PILOT",
  "project": "custom-3x3-pilot",
  "language": "ko-KR",
  "display": {
    "show_internal_ids": false,
    "show_source_hash": false,
    "show_confidence_status": false,
    "technical_detail_location": "APPENDIX",
    "first_use_expand_abbreviation": true
  },
  "active_document_types": [
    "solution_agreement",
    "delivery_scope",
    "acceptance_handover"
  ],
  "default_optional_sections": [],
  "document_overrides": {
    "solution_agreement": {
      "enable_optional": ["범위와_제외범위"],
      "disable_optional": []
    },
    "delivery_scope": {
      "enable_optional": ["테스트와_인수기준"],
      "disable_optional": []
    },
    "acceptance_handover": {
      "enable_optional": ["위험과_대응", "운영_인수"],
      "disable_optional": ["기술_상세_부록"]
    }
  },
  "terminology_overrides": {
    "프로그램": "개발 대상",
    "상위 요구사항": "업무 요청"
  },
  "projection": {
    "prefer_latest_stage_content": true,
    "deduplicate_repeated_content": true,
    "include_unclassified_artifacts": false,
    "include_source_artifact_list_in_appendix": false,
    "legacy_type_requests_are_mapped_to_active_view": true
  }
}
