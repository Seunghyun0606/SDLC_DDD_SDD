{
  "schema_version": 1,
  "provider_id": "DETERMINISTIC_STAGE_PROVIDER",
  "provider_class": "VALIDATION_FIXTURE",
  "enabled": true,
  "timeout_seconds": 30,
  "result_filename": "stage-result.json",
  "allow_dirty_workspace": true,
  "command": [
    "python",
    "sdlc/validation/providers/deterministic_stage_provider.py",
    "--context",
    "{context_path}",
    "--result",
    "{result_path}"
  ],
  "note": "CI validation runner가 자기 runtime fixture를 먼저 생성하므로 이 fixture에만 dirty workspace를 허용한다. Production Provider의 기본 Guard는 변경하지 않으며 실제 Agent/LLM 품질 검증 근거로 사용하지 않는다."
}
